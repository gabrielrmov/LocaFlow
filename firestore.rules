rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Único conjunto de campos que o próprio usuário pode gravar no perfil.
    // Plano, status de assinatura e isAdmin NÃO estão aqui: só as Cloud
    // Functions (Admin SDK, que ignora estas regras) alteram esses campos.
    function profileKeys() {
      return ['email', 'name', 'photoURL', 'updatedAt'];
    }

    // Acesso de escrita: assinatura ativa, conta admin, ou teste de 15 dias ainda
    // dentro do prazo. A data de fim (trialEndsAt) só é gravada pelas Cloud
    // Functions e é comparada com o relógio do servidor (request.time), então
    // não dá para estender o teste mudando a hora do aparelho. Sem trialEndsAt,
    // o teste não vale.
    function hasAccess(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.get('subscriptionStatus', '') == 'active'
        || u.get('isAdmin', false) == true
        || (u.get('subscriptionStatus', '') == 'trialing'
            && u.get('trialEndsAt', request.time) > request.time);
    }

    // O usuário lê o próprio perfil e só edita os campos de identificação.
    // Sem listagem, sem exclusão.
    // Conta admin (campo isAdmin, que só as Functions/console gravam). Pode listar os
    // usuários e mudar apenas plano e status de assinatura: serve de reserva para o
    // painel "Clientes Locarion" quando as Cloud Functions estão fora do ar.
    function isAdminUser() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdminUser();
      allow list: if isAdminUser();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileKeys());
      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys()))
        || (isAdminUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'subscriptionStatus', 'updatedAt'])
          && request.resource.data.get('subscriptionStatus', '') in ['active', 'inactive', 'canceled']
          && request.resource.data.get('plan', 'locarion') in ['locarion', 'profissional', 'enterprise']);
      allow delete: if false;
    }

    // Dados da empresa (equipamentos, contratos, clientes...) ficam
    // isolados por uid do dono da conta Google. Leitura sempre liberada ao
    // dono; escrita só com assinatura ativa.
    match /companies/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && hasAccess(uid);

      match /{collection}/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && hasAccess(uid);
      }
    }

    // Só as Cloud Functions (Admin SDK) leem e escrevem aqui —
    // createAsaasCheckout cria o registro e confirmSubscription o consome
    // depois que o webhook do Asaas confirma o pagamento.
    match /pendingCheckouts/{token} {
      allow read, write: if false;
    }

    // Chave de API do WhatsApp automático (WA-AKG). Só Functions.
    match /waGateways/{uid} {
      allow read, write: if false;
    }

    // Controle de frequência de chamadas (createAsaasCheckout). Só Functions.
    match /rateLimits/{id} {
      allow read, write: if false;
    }
  }
}
