# Locarion — endurecimento para hospedagem Apache/LiteSpeed (Hostinger).
# Equivale aos cabeçalhos de firebase.json (que só valem no Firebase Hosting).

Options -Indexes
AddDefaultCharset UTF-8

# Páginas HTML sempre revalidam: sem isso o navegador e o CDN da Hostinger guardam versões velhas
# (o site novo demorava a aparecer e o login/painel antigos continuavam sendo servidos).
# Imagens e arquivos estáticos continuam em cache normalmente.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Páginas que não devem aparecer em buscadores (reforça as metatags, vale até para quem não lê o HTML)
<IfModule mod_headers.c>
  <FilesMatch "^(dashboard|locaflow|diagnostico)\.html$">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
  <FilesMatch "^login\.html$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Força HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Nunca serve arquivos internos do projeto
  RewriteRule ^(functions|\.git|\.firebase)(/|$) - [F,L]
  RewriteRule ^(SETUP\.md|README\.md|firebase\.json|firestore\.rules|\.firebaserc)$ - [F,L]
</IfModule>

# Bloqueia arquivos ocultos (exceto .well-known, usado no SSL)
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
